{
  "appId": "com.beat60s.app",
  "appName": "تحدّي الدقيقة",
  "webDir": "www",
  "server": {
    "url": "https://beat60s.com/",
    "errorPath": "error.html",
    "allowNavigation": ["beat60s.com", "*.beat60s.com", "*.supabase.co"]
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true,
    "preferredContentMode": "mobile",
    "scheme": "beat60s",
    "appendUserAgent": "Beat60sApp/1 (iOS)"
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 0, "launchAutoHide": true, "backgroundColor": "#000000", "showSpinner": false, "splashFullScreen": true },
    "StatusBar": { "style": "DARK", "backgroundColor": "#000000" },
    "Keyboard": { "resizeOnFullScreen": true }
  }
}
